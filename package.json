{
  "name": "nextask",
  "version": "1.6.2",
  "description": "NexTask — a fast, offline Kanban todo list and task manager for the desktop, built with Electron, Vue 3, Prisma and SQLite.",
  "main": "main/main.js",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@12.2.0",
  "keywords": [
    "todo",
    "todo-app",
    "todo-list",
    "kanban",
    "task-manager",
    "productivity",
    "desktop-app",
    "electron",
    "vue",
    "vue3",
    "vite",
    "prisma",
    "sqlite",
    "tailwindcss",
    "nextask"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/build.js && electron-builder",
    "build:dev": "node scripts/build.js",
    "build:win": "node scripts/build.js && electron-builder --win",
    "build:mac": "node scripts/build.js && electron-builder --mac",
    "build:linux": "node scripts/build.js && electron-builder --linux",
    "rebuild": "electron-rebuild",
    "sonar": "sonar-scanner",
    "typecheck": "tsc -p src/main/tsconfig.json --noEmit && vue-tsc -p src/renderer/tsconfig.json --noEmit",
    "release": "node scripts/bump-version.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "coverage": "vitest run --coverage",
    "coverage:e2e": "node scripts/coverage-e2e.js",
    "prepare": "husky",
    "postinstall": "electron-rebuild"
  },
  "repository": "https://github.com/Daarunia/NexTask",
  "author": {
    "name": "Maxime Van Eygen",
    "url": "https://github.com/Daarunia"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@playwright/test": "^1.63.0",
    "@primeuix/themes": "^3.0.1",
    "@primevue/auto-import-resolver": "^5.0.2",
    "@primevue/forms": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.6",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "md-editor-v3": "^7.1.0",
    "node-abi": "^4.36.0",
    "picocolors": "^1.1.1",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.2",
    "prisma": "^7.10.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-logger-plugin": "^2.2.3",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "vuedraggable": "4.1.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "croner": "^10.0.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.5"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md,css}": "prettier --write"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "electron-winstaller": true,
    "prisma": true
  },
  "homepage": "https://github.com/Daarunia/NexTask#readme"
}
