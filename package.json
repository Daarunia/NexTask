{
  "name": "nextask",
  "version": "1.0.2",
  "description": "NexTask — a modern cross-platform desktop todo app built with Electron, Vue 3, Prisma and TailwindCSS.",
  "main": "main/main.js",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.2",
  "keywords": [
    "electron",
    "vue",
    "vite",
    "desktop-app",
    "todo",
    "nextask",
    "sqlite",
    "prisma"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/build.js && electron-builder",
    "build:dev": "node scripts/build.js",
    "build:win": "node scripts/build.js && electron-builder --win",
    "build:mac": "node scripts/build.js && electron-builder --mac",
    "build:linux": "node scripts/build.js && electron-builder --linux",
    "icons": "node scripts/generate-icons.js",
    "rebuild": "electron-rebuild",
    "sonar": "sonar-scanner",
    "typecheck": "tsc -p src/main/tsconfig.json --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "prepare": "husky",
    "postinstall": "electron-rebuild"
  },
  "repository": "https://github.com/Daarunia/NexTask",
  "author": {
    "name": "Maxime Van Eygen",
    "url": "https://github.com/Daarunia"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@primevue/auto-import-resolver": "^5.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "chokidar": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "node-abi": "^4.35.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@primeuix/themes": "^3.0.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "fastify": "^5.12.1",
    "picocolors": "^1.1.1",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.1",
    "vue": "^3.5.42",
    "vue-logger-plugin": "^2.2.3",
    "vue-router": "^5.3.0",
    "vuedraggable": "4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md,css}": "prettier --write ."
  }
}
