{
  // Compile le main et src/core ensemble (core n'importe rien du main, cf.
  // src/core/tsconfig.json). rootDir = src, d'où build/main et build/core côte à côte.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "outDir": "../../build",
    "noImplicitAny": false,
    "types": ["node", "electron"]
  },
  "include": ["**/*.ts", "../core/**/*.ts"],
  "exclude": ["../../build", "preload/**/*.ts"]
}
