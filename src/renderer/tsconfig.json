{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "types": ["vite/client"],
    // Alias de src/core, à garder aligné sur vite.config.mjs
    "paths": {
      "@core/*": ["../core/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "./**/*.tsx",
    "./**/*.vue",
    "../../types/electron.d.ts",
    "../../types/shims-vue.d.ts",
    "../../types/components.d.ts"
  ]
}
