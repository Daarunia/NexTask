{
  "appId": "com.daarunia.nextask",
  "productName": "NexTask",
  "publish": {
    "provider": "github",
    "owner": "Daarunia",
    "repo": "NexTask"
  },
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "NexTask",
    "installerIcon": "resources/icon.ico",
    "uninstallerIcon": "resources/icon.ico",
    "installerHeaderIcon": "resources/icon.ico"
  },
  "win": {
    "forceCodeSigning": false,
    "icon": "resources/icon.ico",
    "target": ["nsis", "zip"]
  },
  "mac": {
    "icon": "resources/icon.png",
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["snap"],
    "icon": "resources/icon.png",
    "category": "Utility"
  },
  "files": [
    "package.json",
    {
      "from": "build/main/",
      "to": "main"
    },
    {
      "from": "build/renderer",
      "to": "renderer"
    },
    "!**/*.map",
    "!**/node_modules/**/{docs/**,*.d.ts,*.d.mts,*.d.cts}",
    "!**/node_modules/**/{README,readme,Readme,CHANGELOG,changelog,History,HISTORY,SECURITY,CONTRIBUTING,GOVERNANCE}.md",
    "!**/node_modules/@prisma/client/runtime/*{postgresql,mysql,sqlserver,cockroachdb}*",
    "!**/node_modules/@prisma/client/runtime/{query_compiler_small_,wasm-compiler-edge}*",
    "!**/node_modules/@prisma/client/runtime/*.wasm-base64.js",
    "!**/node_modules/better-sqlite3/{deps,src,bin}/**",
    "!**/node_modules/better-sqlite3/build/{deps/**,*.vcxproj*}",
    "!**/node_modules/better-sqlite3/build/Release/{obj/**,test_extension*,*.iobj,*.ipdb,*.lib,*.exp}"
  ],
  "extraResources": [
    {
      "from": "src/main/static",
      "to": "static"
    },
    {
      "from": "src/main/prisma/migrations",
      "to": "prisma/migrations"
    },
    {
      "from": "src/main/prisma/seeds",
      "to": "prisma/seeds"
    }
  ]
}
