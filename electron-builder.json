{
  "appId": "com.daarunia.nextask",
  "productName": "NexTask",
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "NexTask",
    "installerIcon": "resources/icon.ico",
    "uninstallerIcon": "resources/icon.ico",
    "installerHeaderIcon": "resources/icon.ico"
  },
  "win": {
    "forceCodeSigning": false,
    "icon": "resources/icon.ico",
    "target": ["nsis", "zip"]
  },
  "mac": {
    "icon": "resources/icon.png",
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["snap"],
    "icon": "resources/icon.png",
    "category": "Utility"
  },
  "files": [
    {
      "from": "build/main/",
      "to": "main",
      "filter": ["**/*"]
    },
    {
      "from": "src/main/static",
      "to": "static",
      "filter": ["**/*"]
    },
    {
      "from": "build/renderer",
      "to": "renderer",
      "filter": ["**/*"]
    },
    "!build",
    "!dist",
    "!scripts"
  ],
  "extraResources": [
    {
      "from": "src/main/static",
      "to": "static"
    },
    {
      "from": "build/main/prisma",
      "to": "prisma"
    },
    {
      "from": "src/main/prisma/migrations",
      "to": "prisma/migrations"
    },
    {
      "from": "src/main/prisma/seeds",
      "to": "prisma/seeds"
    }
  ]
}
